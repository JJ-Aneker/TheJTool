{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/eform-ai.js": {
      "maxDuration": 120,
      "memory": 1024
    },
    "api/build-docx.js": {
      "maxDuration": 120,
      "memory": 1024
    },
    "api/analyze.js": {
      "maxDuration": 120,
      "memory": 1024
    },
    "api/bedrock.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/export-gantt.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/export-vertical.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/app-routes.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/questionnaires.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/rfp-api.js": {
      "maxDuration": 120,
      "memory": 1024
    },
    "api/therefore-connect.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/verticales.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/eform-ai-routes.js": {
      "maxDuration": 120,
      "memory": 1024
    },
    "api/parse-licensing-request.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/analyze-licensing.js": {
      "maxDuration": 120,
      "memory": 1024
    },
    "api/admin-routes.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/dashboard-routes.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/check-env.js": {
      "maxDuration": 10,
      "memory": 256
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/analyze-rfp/:path*",
      "destination": "/api/rfp-api"
    },
    {
      "source": "/api/rfp/:path*",
      "destination": "/api/rfp-api"
    },
    {
      "source": "/api/rfp-status/:path*",
      "destination": "/api/rfp-api"
    },
    {
      "source": "/api/rfp-tags/:path*",
      "destination": "/api/rfp-api"
    },
    {
      "source": "/api/rfp-requirements/:path*",
      "destination": "/api/rfp-api"
    },
    {
      "source": "/api/rfp-scoring/:path*",
      "destination": "/api/rfp-api"
    },
    {
      "source": "/api/rfp-risk-clauses/:path*",
      "destination": "/api/rfp-api"
    },
    {
      "source": "/api/answer-library/:path*",
      "destination": "/api/rfp-api"
    },
    {
      "source": "/api/rfp-compare",
      "destination": "/api/rfp-api"
    },
    {
      "source": "/api/rfp-generate-viability/:path*",
      "destination": "/api/rfp-api"
    },
    {
      "source": "/api/rfp-generate-tasks/:path*",
      "destination": "/api/rfp-api"
    },
    {
      "source": "/api/rfp-dashboard",
      "destination": "/api/rfp-api"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
